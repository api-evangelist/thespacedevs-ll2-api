              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "API endpoint that allows API Throttle information to be viewed.\n\nGET:\nReturns a range of information about your API access"
        }
      ]
    }
  ],
  "bundled": true
